{
  "name": "omni-code",
  "version": "0.1.0",
  "description": "Multi-LLM AI coding assistant for the terminal",
  "type": "module",
  "bin": {
    "omni-code": "./bin/omni-code.mjs",
    "oc": "./bin/omni-code.mjs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "test": "vitest",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ai",
    "coding-assistant",
    "cli",
    "llm",
    "openai",
    "anthropic",
    "gemini",
    "grok",
    "ollama"
  ],
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@google/generative-ai": "^0.24.1",
    "@mistralai/mistralai": "^1.14.1",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "better-sqlite3": "^12.6.2",
    "chalk": "^5.4.1",
    "commander": "^14.0.3",
    "dotenv": "^16.5.0",
    "glob": "^11.0.0",
    "groq-sdk": "^0.37.0",
    "ink": "^5.1.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "marked": "^15.0.0",
    "marked-terminal": "^7.3.0",
    "minimatch": "^10.0.0",
    "nanoid": "^5.1.0",
    "openai": "^4.82.0",
    "p-queue": "^8.1.0",
    "p-retry": "^6.2.1",
    "react": "^18.3.1",
    "shiki": "^3.2.0",
    "signal-exit": "^4.1.0",
    "simple-git": "^3.27.0",
    "strip-ansi": "^7.1.0",
    "tree-kill": "^1.2.2",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "eslint": "^9.18.0",
    "ink-testing-library": "^4.0.0",
    "prettier": "^3.5.0",
    "tsup": "^8.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
