{
  "name": "omni-code",
  "version": "0.1.0",
  "description": "Multi-LLM AI coding assistant for the terminal",
  "type": "module",
  "bin": {
    "omni-code": "./bin/omni-code.mjs",
    "oc": "./bin/omni-code.mjs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "test": "vitest",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "electron:dev": "node scripts/electron-dev.mjs",
    "electron:run": "ELECTRON_RUN_AS_NODE= electron .",
    "dev:vite": "vite -c electron.vite.config.ts",
    "electron:build": "npm run build && vite build -c electron.vite.config.ts && electron-builder",
    "electron:pack": "electron-builder --dir",
    "postinstall": "electron-builder install-app-deps"
  },
  "main": "dist-electron/main/electron.cjs",
  "homepage": ".",
  "keywords": [
    "ai",
    "coding-assistant",
    "cli",
    "llm",
    "openai",
    "anthropic",
    "gemini",
    "grok",
    "ollama"
  ],
  "license": "MIT",
  "build": {
    "appId": "com.omni-code.app",
    "productName": "Omni Code",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist-electron/**/*",
      "logo.png",
      "!dist-electron/main/*.map",
      "!dist-electron/renderer/*.map"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns"
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1000.0",
    "@google/generative-ai": "^0.24.1",
    "@mistralai/mistralai": "^1.14.1",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@ngrok/ngrok": "^1.5.0",
    "@monaco-editor/react": "^4.7.0",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "@xenova/transformers": "^2.17.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^12.6.2",
    "chalk": "^5.4.1",
    "commander": "^14.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "duckduckgo-search": "^1.0.7",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "electron-store": "^11.0.2",
    "fast-glob": "^3.3.3",
    "glob": "^11.0.0",
    "groq-sdk": "^0.37.0",
    "hnswlib-node": "^3.0.0",
    "ink": "^5.1.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "lucide-react": "^0.577.0",
    "marked": "^15.0.0",
    "marked-terminal": "^7.3.0",
    "minimatch": "^10.0.0",
    "monaco-editor": "^0.55.1",
    "nanoid": "^5.1.0",
    "node-pty": "^1.1.0",
    "openai": "^4.82.0",
    "p-queue": "^8.1.0",
    "p-retry": "^6.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-resizable-panels": "^4.7.1",
    "shiki": "^3.2.0",
    "signal-exit": "^4.1.0",
    "simple-git": "^3.27.0",
    "strip-ansi": "^7.1.0",
    "tree-cli": "^0.6.7",
    "tree-kill": "^1.2.2",
    "uuid": "^10.0.0",
    "vite": "^7.3.1",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "xterm-addon-web-links": "^0.9.0",
    "zod": "^3.24.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/uuid": "^10.0.0",
    "concurrently": "^9.2.1",
    "electron": "^40.8.0",
    "eslint": "^9.39.3",
    "ink-testing-library": "^4.0.0",
    "prettier": "^3.8.1",
    "tsup": "^7.2.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "wait-on": "^9.0.4"
  }
}
